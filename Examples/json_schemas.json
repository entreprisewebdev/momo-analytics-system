{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoMo Analytics System",
  "description": "JSON schema for MoMo transaction data and related entities",
  "type": "object",

  "properties": {
    "user": {
      "$ref": "#/$defs/user"
    },

    "category": {
      "$ref": "#/$defs/category"
    },

    "transaction": {
      "$ref": "#/$defs/transaction"
    },

    "system_log": {
      "$ref": "#/$defs/system_log"
    }
  },

  "$defs": {
    "user": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "integer"
        },
        "phone_number": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "phone_number",
        "name"
      ]
    },

    "category": {
      "type": "object",
      "properties": {
        "category_id": {
          "type": "integer"
        },
        "category_name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "category_id",
        "category_name"
      ]
    },

    "participant": {
      "type": "object",
      "properties": {
        "user": {
          "$ref": "#/$defs/user"
        },
        "role": {
          "type": "string",
          "enum": [
            "SENDER",
            "RECEIVER"
          ]
        }
      },
      "required": [
        "user",
        "role"
      ]
    },

    "system_log": {
      "type": "object",
      "properties": {
        "log_id": {
          "type": "integer"
        },
        "transaction_id": {
          "type": "integer"
        },
        "log_message": {
          "type": "string"
        },
        "log_level": {
          "type": "string",
          "enum": [
            "INFO",
            "WARNING",
            "ERROR"
          ]
        },
        "log_time": {
          "type": "string"
        }
      },
      "required": [
        "log_id",
        "transaction_id",
        "log_message",
        "log_level",
        "log_time"
      ]
    },

    "transaction": {
      "type": "object",
      "properties": {
        "transaction_id": {
          "type": "integer"
        },
        "amount": {
          "type": "number"
        },
        "transaction_time": {
          "type": "string"
        },
        "processed_by": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "PENDING",
            "FAILED"
          ]
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/participant"
          }
        },
        "system_logs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system_log"
          }
        }
      },
      "required": [
        "transaction_id",
        "amount",
        "transaction_time",
        "processed_by",
        "status",
        "category",
        "participants",
        "system_logs"
      ]
    }
  }
}